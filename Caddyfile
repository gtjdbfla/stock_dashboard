# Tailscale Funnel 뒤에 두는 리버스 프록시.
#  - HTTPS/인증서는 Funnel이 바깥에서 처리하므로, Caddy는 내부에서 평문 HTTP로만 받는다.
#  - 로그인(비밀번호) 없이 누구나 접근 가능한 상태다.
#    (다시 비밀번호를 걸려면 아래에 basic_auth 블록을 추가하고 .env에 DASHBOARD_USER /
#     DASHBOARD_PASSWORD_HASH 를 넣으면 된다.)

:8080 {
	# Streamlit은 웹소켓으로 화면을 갱신한다. reverse_proxy가 자동으로 처리한다.
	#
	# 주소를 그냥 'hynix-dashboard:8501'로 적으면, 대시보드를 재빌드할 때 컨테이너 IP가 바뀌어도
	# Caddy가 예전 IP를 계속 물고 있다가 502를 낸다(실제로 재빌드 직후 172.18.0.4로 계속 붙으려 함).
	# dynamic a로 매번 DNS를 다시 찾게 해서, 재빌드 후에도 몇 초 안에 알아서 새 IP를 잡게 한다.
	reverse_proxy {
		dynamic a {
			name hynix-dashboard
			port 8501
			refresh 5s
		}
	}

	encode gzip

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 3
		}
	}
}
